# Copy to .env and adjust. Loaded by cella.core.config.Settings.

# Where the pipeline reads/writes data (see docs/CONCEPT.md §5).
CELLA_DATA_DIR=./data
CELLA_RAW_DIR=./data/raw
CELLA_PROCESSED_DIR=./data/processed

# CellTypist atlas release stamped onto all artifacts.
CELLA_ATLAS_RELEASE=unset

# PostgreSQL connection for the online app.
CELLA_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cella
